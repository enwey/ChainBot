APP_ENV=local-research
EXECUTION_MODE=paper
ENABLE_LIVE_TRADING=false
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
ADMIN_API_TOKEN=
MAINTENANCE_ENABLED=true
POSITION_SIZE_USD=15
MAX_OPEN_POSITIONS=2
MAX_DAILY_LOSS_USD=40
MAX_CONSECUTIVE_DEPENDENCY_FAILURES=4
DEPENDENCY_FAILURE_WINDOW_SECONDS=300
ABNORMAL_EXIT_COOLDOWN_SECONDS=300
ABNORMAL_EXIT_THRESHOLD=2
ORDER_IDEMPOTENCY_TTL_SECONDS=180
NEWS_ENABLED=true
KOL_MONITOR_ENABLED=true

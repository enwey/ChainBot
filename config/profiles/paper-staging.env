APP_ENV=paper-staging
EXECUTION_MODE=paper
ENABLE_LIVE_TRADING=false
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
ADMIN_API_TOKEN=change-me-paper-token
MAINTENANCE_ENABLED=true
POSITION_SIZE_USD=12
MAX_OPEN_POSITIONS=2
MAX_DAILY_LOSS_USD=25
MAX_CONSECUTIVE_DEPENDENCY_FAILURES=3
DEPENDENCY_FAILURE_WINDOW_SECONDS=180
ABNORMAL_EXIT_COOLDOWN_SECONDS=600
ABNORMAL_EXIT_THRESHOLD=1
ORDER_IDEMPOTENCY_TTL_SECONDS=300
NEWS_ENABLED=true
KOL_MONITOR_ENABLED=true

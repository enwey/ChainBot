APP_ENV=guarded-live
EXECUTION_MODE=live
ENABLE_LIVE_TRADING=true
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
ADMIN_API_TOKEN=change-me-live-token
MAINTENANCE_ENABLED=true
POSITION_SIZE_USD=10
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS_USD=15
MAX_CONSECUTIVE_DEPENDENCY_FAILURES=2
DEPENDENCY_FAILURE_WINDOW_SECONDS=120
ABNORMAL_EXIT_COOLDOWN_SECONDS=900
ABNORMAL_EXIT_THRESHOLD=1
ORDER_IDEMPOTENCY_TTL_SECONDS=300
NEWS_ENABLED=true
KOL_MONITOR_ENABLED=true
SOLANA_PRIVATE_KEY=

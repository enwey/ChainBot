APP_NAME=ChainBot
APP_ENV=local-research
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATA_DIR=data
WEB_DIR=web

EXECUTION_MODE=paper
ENABLE_LIVE_TRADING=false
ADMIN_API_TOKEN=local-dev-token

INITIAL_BALANCE_USD=300
POSITION_SIZE_USD=15
MAX_OPEN_POSITIONS=2
MAX_POSITION_SIZE_USD=25
MAX_WALLET_EXPOSURE_PCT=0.12
MAX_DAILY_LOSS_USD=40
MAX_CONSECUTIVE_DEPENDENCY_FAILURES=4
ABNORMAL_EXIT_COOLDOWN_SECONDS=300
ABNORMAL_EXIT_THRESHOLD=2

MAINTENANCE_ENABLED=true
SCAN_LOG_RETENTION_DAYS=7
OPPORTUNITY_RETENTION_DAYS=14
NEWS_EVENT_RETENTION_DAYS=3
DECISION_AUDIT_RETENTION_DAYS=30

NEWS_ENABLED=true
KOL_MONITOR_ENABLED=true
FEISHU_WEBHOOK_URL=

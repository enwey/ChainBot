APP_NAME=ChainBot
APP_ENV=paper-staging
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATA_DIR=data
WEB_DIR=web

EXECUTION_MODE=paper
ENABLE_LIVE_TRADING=false
ADMIN_API_TOKEN=replace-with-strong-token

INITIAL_BALANCE_USD=1000
POSITION_SIZE_USD=20
MAX_OPEN_POSITIONS=3
MAX_POSITION_SIZE_USD=30
MAX_WALLET_EXPOSURE_PCT=0.1
MAX_DAILY_LOSS_USD=60
MAX_CONSECUTIVE_DEPENDENCY_FAILURES=3
DEPENDENCY_FAILURE_WINDOW_SECONDS=300
ABNORMAL_EXIT_COOLDOWN_SECONDS=600
ABNORMAL_EXIT_THRESHOLD=2

MAINTENANCE_ENABLED=true
SCAN_LOG_RETENTION_DAYS=14
OPPORTUNITY_RETENTION_DAYS=21
NEWS_EVENT_RETENTION_DAYS=5
DECISION_AUDIT_RETENTION_DAYS=45

NEWS_ENABLED=true
KOL_MONITOR_ENABLED=true
FEISHU_WEBHOOK_URL=

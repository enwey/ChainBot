APP_NAME=ChainBot
APP_ENV=guarded-live
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATA_DIR=data
WEB_DIR=web

EXECUTION_MODE=live
ENABLE_LIVE_TRADING=true
ADMIN_API_TOKEN=replace-with-strong-token
SOLANA_PRIVATE_KEY=replace-with-real-key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

INITIAL_BALANCE_USD=500
POSITION_SIZE_USD=10
MAX_OPEN_POSITIONS=1
MAX_POSITION_SIZE_USD=15
MAX_WALLET_EXPOSURE_PCT=0.06
MAX_DAILY_LOSS_USD=25
MAX_CONSECUTIVE_DEPENDENCY_FAILURES=2
DEPENDENCY_FAILURE_WINDOW_SECONDS=180
ABNORMAL_EXIT_COOLDOWN_SECONDS=900
ABNORMAL_EXIT_THRESHOLD=1
ORDER_IDEMPOTENCY_TTL_SECONDS=300

MAINTENANCE_ENABLED=true
SCAN_LOG_RETENTION_DAYS=21
OPPORTUNITY_RETENTION_DAYS=30
NEWS_EVENT_RETENTION_DAYS=7
DECISION_AUDIT_RETENTION_DAYS=60

NEWS_ENABLED=true
KOL_MONITOR_ENABLED=true
FEISHU_WEBHOOK_URL=
